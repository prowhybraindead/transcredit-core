NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Paste the ENTIRE Service Account JSON as a single line string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Public base URL of this app (used to construct paymentUrl)
# Local: http://localhost:3000  |  Production: https://your-core.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:3000

# Allowed CORS origin for the Demo Shop
# Local: http://localhost:3001  |  Production: https://your-shop.vercel.app
ALLOWED_ORIGIN=http://localhost:3001
